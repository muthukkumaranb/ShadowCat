digraph SIH26153 {
  graph [rankdir=TB, fontname="Helvetica", fontsize=13, labelloc=t,
         label="SIH26153 — Cyber World Model Architecture   (revised 2026-09-03, aligned to v3 Final Plan)\nsolid edge = runtime inference / demo path      dashed orange edge = training & evaluation only      dotted border = optional / post-MVP",
         pad=0.3, nodesep=0.25, ranksep=0.38, splines=true, compound=true, newrank=true]
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=8,
         fillcolor="#ffffff", color="#555555", margin="0.12,0.06"]
  edge  [fontname="Helvetica", fontsize=7, color="#444444", arrowsize=0.65]

  /* ================= GATE 0 ================= */
  gate0 [fillcolor="#e5e7eb", label="Gate 0 — dataset feasibility check (before any model work)\nreconcile PCAP ↔ CSV timestamps & flow identities · count independent attack episodes + pre-onset history\nverify ≥ 2 defensible progression stages (infiltration day: exploit phase → internal-scan phase)\nschedule-artifact leakage test (trivial model ± IP / day / time-of-day) · packet-feature reproducibility\nEXIT: freeze primary claim — onset forecasting, progression forecasting, or both. Never manufacture evidence."]

  /* ================= INPUTS ================= */
  subgraph cluster_in {
    label="Input data"; style="rounded,filled"; fillcolor="#f8fafc"; color="#94a3b8"; fontsize=10
    pcap  [fillcolor="#dbeafe", label="PCAP\ndemo: bundled small sample + cached extraction\nlive extraction path retained"]
    csv   [fillcolor="#dbeafe", label="CSV — corrected-CICFlowMeter feature schema (documented)\nother CSVs → canonical mapper, else rejected\nnever silently fed as an all-missing packet family"]
    annot [fillcolor="#fef3c7", color="#d97706", label="Attack timeline annotations (training only)\nCIC-IDS2018 scenario schedules,\nrelabeled per Engelen / Lanvin corrections"]
  }
  future [shape=note, style="dashed", color="#9ca3af", fontcolor="#6b7280",
          label="Future work — NOT in MVP\nauthentication logs (LANL) on a separate dataset\nwith its own state schema; never fused into this S(t)"]

  /* ================= DATA ENGINEERING ================= */
  de [fillcolor="#e5e7eb", label="Data engineering\nclean → canonical field map → timestamp normalize (UTC) → missing-value handling (missing ≠ zero; never fabricate baselines)\n→ windowing (default 1-min, tunable) → timeline alignment\ntraining data: corrected CICFlowMeter / relabeled sets — not raw shipped CSVs"]

  /* ================= FEATURE EXTRACTION ================= */
  subgraph cluster_fe {
    label="Feature extraction (project-owned pipeline)"; style="rounded,filled"; fillcolor="#f8fafc"; color="#94a3b8"; fontsize=10
    flow   [fillcolor="#d1fae5", label="Flow level\nIP/port pairs · TCP flag bitmask · protocol\nbytes / packets per flow · duration\nIAT mean / var / max · bidirectional ratio"]
    packet [fillcolor="#d1fae5", label="Packet level (Scapy / PyShark)\nTTL values + variance · TCP window size · IP fragment flags\npayload-size distribution · retransmission counts\nport-scan sequencing (sequential vs randomised)"]
    graphb [fillcolor="#d1fae5", style="rounded,filled,dotted", color="#6b7280", label="Communication-graph builder (optional, per window)\nsrc/dst IP–port edges → graph embedding inside S(t)\nadopted only if it measurably beats the temporal-only model"]
  }

  ucs [fillcolor="#e5e7eb", label="Unified cyber state S(t)\nflow + packet (+ optional graph-embedding) features · metadata kept separate from model inputs\nfeature-presence masks · retained flow-to-window index"]

  /* ================= TRAINING-ONLY ================= */
  subgraph cluster_train {
    label="Training-time only"; style="rounded,filled,dashed"; fillcolor="#fffbeb"; color="#d97706"; fontsize=10
    split [fillcolor="#fef3c7", label="Chronological split → purge → embargo\n(width ≥ max lookback + forecast horizon)\nnormalizers fitted on TRAIN only · thresholds on VALIDATION only\nleakage rule: an input at time t uses information ≤ t — no future-derived statistics"]
    targets [fillcolor="#fef3c7", label="Target construction (from timeline annotations)\nnext-state S(t+1) · onset target y_onset(t) · progression target y_stage(t+k)\nATT&CK mapping manifest: source_label · interval · telemetry · tactic(s) · confidence · rationale\nDoS/DDoS = Impact (own category; PS five-phase list noted as limitation)\nbrute force = Credential Access unless success evidenced · infiltration annotated by phase\nUnknown/Other and multi-label allowed internally"]
  }

  /* ================= ENCODER ================= */
  enc [fillcolor="#ede9fe", label="State encoder → latent state z(t)\nLSTM / GRU over S(t−L+1 … t)\nattention pooling optional — shown as model internals only"]

  /* ================= WORLD MODEL ================= */
  subgraph cluster_wm {
    label="Cyber world model — learned state-transition dynamics"; style="rounded,filled"; fillcolor="#f8fafc"; color="#94a3b8"; fontsize=10
    dyn [fillcolor="#e5e7eb", label="Probabilistic dynamics head   p(z(t+1) | history)\nGaussian μ,σ / quantiles / small ensemble\nTRAINED WITH: one-step NLL + explicit K-step rollout loss\nscheduled sampling only as an ablation, never a default\nif only point regression ships → call it a deterministic approximation"]
    losses [shape=note, fillcolor="#fffbeb", color="#d97706", fontsize=7.5, label="Losses\ndynamics NLL + K-step rollout loss\nhazard NLL · stage CE · direct BCE"]
    roll [fillcolor="#e5e7eb", label="K-step latent rollout   ẑ(t+1) … ẑ(t+K)\nuncertainty grows with depth — measured as rollout error vs K"]
    hazard [fillcolor="#e5e7eb", label="Hazard head — one per evaluation track\nh_k^onset: first onset at step k · h_k^stage: next-stage transition at step k\ncumulative P(event ≤ K) = 1 − Π(1 − h_k) → probability trajectory"]
    stage [fillcolor="#e5e7eb", label="Stage head — from the PREDICTED future state\nlabels from the mapping manifest\nstage assigned only where training evidence supports it\n(else Unknown/Other)"]
    direct [fillcolor="#f3f4f6", label="Direct forecast head   P(event within H)\nbaseline & safety net\ndisplayed only as “baseline comparison”"]
  }

  /* ================= EXPLAINABILITY ================= */
  subgraph cluster_xai {
    label="Explainability — three evidence types, never conflated"; style="rounded,filled"; fillcolor="#f8fafc"; color="#94a3b8"; fontsize=10
    xai_fc [fillcolor="#fce7f3", label="Forecast explanation\nIntegrated Gradients / feature ablation (SHAP-family attribution)\nattributes the hazard / stage output to observed history S(t−k..t)\nvalidated by deletion tests · attention shown as internals only"]
    xai_tr [fillcolor="#fce7f3", label="Trajectory evidence\nlargest PREDICTED feature changes along ẑ(t+1 … t+K)\nlabeled “predicted” — never “residual”"]
    xai_nv [fillcolor="#fce7f3", label="Current novelty (online, one step behind)\nobserved S(t) vs forecast Ŝ(t) made at t−1\nper-feature / per-entity residual → unseen-behaviour alert"]
    flows [fillcolor="#e5e7eb", label="Flagged flows\nresolved through the retained flow-to-window index\n+ documented attribution rule"]
  }

  outputs [fillcolor="#e5e7eb", color="#111827", penwidth=1.4, label="Forecast outputs (runtime)\nprobability trajectory + uncertainty bands  ← hazard head\nstage trajectory  ← stage head\nfuture state trajectory  ← rollout\nbaseline comparison  ← direct head"]

  enrich [style="rounded,filled,dotted", color="#9ca3af", fontcolor="#6b7280",
          label="Optional post-MVP enrichment\non the stage output\nCAPEC pattern context · CVE/NVD\n(only with host-inventory evidence)"]

  /* ================= UI ================= */
  ui [fillcolor="#d1d5db", label="Demonstration UI — Streamlit, fully offline, no cloud dependency\ndual input contract:  PCAP → full pipeline (flow + packet)   |   CSV → flow-only model (documented schema, evaluated separately)\nOUTPUTS: probability trajectory + uncertainty bands · stage trajectory · future state trajectory · driving features\nflagged flows · current novelty score · LR-baseline comparison (same interface)\nevery displayed number labeled with the branch that produced it"]

  /* ================= EVALUATION ================= */
  subgraph cluster_eval {
    label="Evaluation (offline, training-time)"; style="rounded,filled,dashed"; fillcolor="#fffbeb"; color="#d97706"; fontsize=10
    ablation [fillcolor="#fef3c7", label="Ablation grid\ndirect-only · rollout + hazard-only · joint\n± scheduled sampling · ± graph embedding\nevery result labeled with its source branch"]
    tracks [fillcolor="#fed7aa", label="Two separate tracks\nONSET: cutoff before first malicious event → onset within H (no credit after onset)\nPROGRESSION: cutoff during a known early stage → later stage within K\n(no credit for mere persistence)"]
    baselines [fillcolor="#dbeafe", label="Baselines — identical splits, purge/embargo, input availability\nLR current-window (PS-mandated) · LR lagged-windows · persistence / last-state\ndirect head · full world model · LR explanation: standardized coefficients"]
    metrics [fillcolor="#dbeafe", label="Metrics\nPS-mandated: F1 · precision · recall · FPR (vs LR)\nforecasting: per-episode lead time · false alarms per unit time · PR-AUC · calibration (reliability + Brier)\nworld model: next-state error · rollout error vs K · deviation-score ROC · predictive-interval coverage\nreporting: per-episode with CIs across episodes / seeds — overlapping windows ≠ independent samples"]
    unseen [fillcolor="#fed7aa", label="Unseen-attack generalization — leave-one-attack-family-out\nthresholds & preprocessing fitted without the held-out family\nthree separate claims: risk detection · novelty scoring · stage classification only where supported"]
  }

  art [fillcolor="#fef9c3", color="#ca8a04", label="Reproducibility artifacts (PS deliverable)\ntraining scripts · configs · model weights · data manifest · seeds · environment lock · known limitations"]

  /* ================= RUNTIME EDGES (solid) ================= */
  gate0  -> de      [label=" gates the whole pipeline", penwidth=1.4]
  pcap   -> de
  csv    -> de
  future -> pcap    [style=invis]
  de     -> flow
  de     -> packet
  de     -> graphb  [style=dotted]
  flow   -> ucs
  packet -> ucs
  graphb -> ucs     [style=dotted]
  ucs    -> enc
  enc    -> dyn
  enc    -> direct
  dyn    -> roll
  roll   -> hazard
  roll   -> stage
  roll   -> xai_tr
  roll   -> xai_nv  [label=" Ŝ(t): first rollout step\n made at t−1"]
  hazard -> outputs [penwidth=1.5]
  stage  -> outputs [penwidth=1.5]
  roll   -> outputs [penwidth=1.5, constraint=false]
  direct -> outputs
  outputs -> ui     [penwidth=1.5]
  ucs    -> xai_fc  [lhead=cluster_xai, label=" observed S(t) · history S(t−k..t)\n · flow-to-window index", color="#7c3aed", penwidth=1.2, constraint=false]
  hazard -> xai_fc  [label=" output to attribute", style=dotted]
  xai_fc -> flows   [label=" attribution rule", style=dotted]
  xai_fc -> ui
  xai_tr -> ui
  xai_nv -> ui
  flows  -> ui
  stage  -> enrich  [style=dotted]

  /* ================= TRAINING / EVAL EDGES (dashed) ================= */
  annot   -> targets  [style=dashed, color="#d97706", constraint=false]
  ucs     -> split    [style=dashed, color="#d97706"]
  ucs     -> targets  [style=dashed, color="#d97706", label=" windowed states"]
  split   -> enc      [style=dashed, color="#d97706", label=" train / val / test tensors"]
  targets -> dyn      [style=dashed, color="#d97706", label=" S(t+1) target", constraint=false]
  targets -> hazard   [style=dashed, color="#d97706", label=" y_onset · y_stage", constraint=false]
  targets -> stage    [style=dashed, color="#d97706", constraint=false]
  losses  -> dyn      [style=dashed, color="#d97706", arrowhead=none]
  hazard  -> ablation [style=dashed, color="#d97706"]
  direct  -> ablation [style=dashed, color="#d97706"]
  ablation  -> tracks    [style=dashed, color="#d97706"]
  tracks    -> baselines [style=dashed, color="#d97706"]
  baselines -> metrics   [style=dashed, color="#d97706"]
  metrics   -> unseen    [style=dashed, color="#d97706"]
  metrics   -> art       [style=dashed, color="#d97706", label=" tables & figures"]
  dyn       -> art       [style=dashed, color="#d97706", label=" weights · configs", constraint=false]
  metrics   -> ui        [style=dashed, color="#d97706", label=" LR-vs-model comparison", constraint=false]

  /* ================= rank hints ================= */
  { rank=same; gate0; future }
  { rank=same; split; targets }
  { rank=same; dyn; losses }
  { rank=same; hazard; stage; direct }
  { rank=same; xai_fc; xai_tr; xai_nv; outputs; enrich }
}
